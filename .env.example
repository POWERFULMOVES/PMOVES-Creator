# PMOVES-Creator Hybrid Standalone Mode Configuration
# Run ComfyUI independently while optionally connecting to PMOVES.AI services

# =============================================================================
# MODE DETECTION
# =============================================================================
# Set to false when running standalone (independent Docker Compose)
# Set to true when running as part of PMOVES.AI docker-compose
DOCKED_MODE=false
PARENT_SYSTEM=PMOVES.AI

# =============================================================================
# GPU CONFIGURATION
# =============================================================================
# Which GPU devices to use (all, 0, 1, etc.)
NVIDIA_VISIBLE_DEVICES=all
GPU_COUNT=all

# CUDA configuration for optimal performance across GPU generations
CUDA_FORCE_PTX_JIT=1
TORCH_CUDA_ARCH_LIST=5.0;5.2;6.0;6.1;7.0;7.5;8.0;8.6;9.0

# NVIDIA driver capabilities
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# =============================================================================
# TENSORZERO INTEGRATION (Optional)
# =============================================================================
# TensorZero Gateway for LLM-based ComfyUI workflows
# Leave empty to run without TensorZero
TENSORZERO_URL=http://host.docker.internal:3030
TENSORZERO_API_KEY=
TENSORZERO_CHAT_MODEL=qwen2_5_14b
TENSORZERO_EMBED_MODEL=text-embedding-3-small

# =============================================================================
# PMOVES.AI SERVICES (Optional - Hybrid Mode)
# =============================================================================
# Render Webhook - for output handling and storage
RENDER_WEBHOOK_URL=http://host.docker.internal:8085/comfy/webhook
RENDER_WEBHOOK_SHARED_SECRET=change-me-in-production

# MinIO - S3-compatible storage for outputs
# Leave empty to use local volume storage only
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pmoves-comfyui

# =============================================================================
# COMFYUI CONFIGURATION
# =============================================================================
# ComfyUI server settings
COMFYUI_HOST=0.0.0.0
COMFYUI_PORT=8188
COMFYUI_OUTPUT_DIR=/app/output

# =============================================================================
# PRODUCTION NGINX PROXY (Optional)
# =============================================================================
# Enable with: docker compose --profile production up -d
NGINX_PORT=80
NGINX_SSL_PORT=443

# =============================================================================
# NOTES
# =============================================================================
#
# Fully Standalone Mode (No PMOVES.AI):
#   docker compose up -d
#
# Hybrid Mode (With PMOVES.AI services):
#   export TENSORZERO_URL=http://host.docker.internal:3030
#   export RENDER_WEBHOOK_URL=http://host.docker.internal:8085/comfy/webhook
#   docker compose up -d
#
# Verify PMOVES.AI connectivity from container:
#   docker exec -it pmoves-creator-comfyui curl http://host.docker.internal:3030/healthz
#
# For Linux hosts, ensure host.docker.internal works:
#   docker compose --add-host=host.docker.internal:host-gateway up -d
